# Model provider: stub (offline, deterministic), openai, or anthropic
RELAY_PROVIDER=stub
RELAY_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage. Leave RELAY_DATABASE_URL empty to run fully in memory.
RELAY_DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
RELAY_CHECKPOINTER=postgres
RELAY_OPENSEARCH_URL=http://localhost:9200
RELAY_LOG_INDEX=app-logs

# Agent behaviour
RELAY_MAX_STEPS=12
RELAY_APPROVAL_TOOLS=draft_reply,escalate_to_human
RELAY_QUOTE_RETRIEVED=true

# Voicemail transcription (needs the voice extra)
RELAY_WHISPER_MODEL=base

# Tracing
RELAY_OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=relay
